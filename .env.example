# Application environment (dev | prod)
ENV=dev

# Logging
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DSN=postgresql://ipu:ipu@localhost:5432/ipu

# Redis
REDIS_URL=redis://localhost:6379/0

# Parquet time-series cache directory
PARQUET_DIR=./data/parquet

# Optional: Twelve Data API key (leave empty to disable cross-check)
TWELVEDATA_API_KEY=

# Optional: nsepython server mode (leave remote for default NSE REST)
NSEPYTHON_MODE=remote
NSEPYTHON_SERVER=
